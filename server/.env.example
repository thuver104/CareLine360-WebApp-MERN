PORT=1111
MONGO_URI=mongodb+srv://yourname_db_user:password@careline360.jumdxls.mongodb.net/CareLine360 
NODE_ENV=development
CLIENT_URL=http://localhost:5173

JWT_SECRET=_jwt_secret_doctor_management_system


JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRE=7d

CLOUDINARY_CLOUD_NAME= your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here


# Email Configuration (SMTP)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587 
SMTP_USER=your_smtp_user_email_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=no-reply@your-domain.com

# Set this to redirect ALL emails to one address (dev/testing only). Remove in production.
# EMAIL_OVERRIDE_TO=your-email@example.com

GEMINI_API_KEY=your_gemini_api_key_here

# SMSLenz Configuration (for SMS notifications)
# Get these from https://smslenz.lk settings page
SMSLENZ_USER_ID=your_smslenz_user_id_here
SMSLENZ_API_KEY=your_smslenz_api_key_here
SMSLENZ_SENDER_ID=SMSlenzDEMO